<Window x:Class="Admin.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Admin"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Bejelentkezés" FontSize="30" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="Felhasználónév" FontSize="15" HorizontalAlignment="Center"/>
            <TextBox x:Name="tbFelhasznalonev" Width="150" Margin="10"/>
            <TextBlock Text="Jelszó" FontSize="15" HorizontalAlignment="Center"/>
            <TextBox x:Name="tbJelszo" Width="150" Margin="10"/>
            <Button x:Name="btnLogin" Content="Bejelentkezés" Margin="20" Width="100" Height="50" Click="btnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
